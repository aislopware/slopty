---
source: crates/slopty-tools/src/tools.rs
expression: tools
---
[
  {
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "machines"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`agent_start`.",
      "properties": {
        "agent": {
          "description": "`claude` (the default), `codex` or `pi`.",
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "description": "How hard it thinks, by the agent's own name.",
          "type": [
            "string",
            "null"
          ]
        },
        "folder": {
          "description": "The folder it works in, absolute or `~/…`.",
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "description": "A name for this call's effect, such as a fresh UUID; a repeat answers as the first did.",
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "description": "The machine, by name or id.",
          "type": "string"
        },
        "model": {
          "description": "The model, by the agent's own id.",
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "description": "What the agent is told first.",
          "type": "string"
        },
        "repo": {
          "description": "A remote repository's address: the machine's clone of it is the folder, made first\nwhen there is none.",
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "description": "A fresh git worktree of the folder's clone, by this name, on the branch\n`worktree-<name>`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "machine",
        "prompt"
      ],
      "title": "AgentStartArgs",
      "type": "object"
    },
    "name": "agent_start"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`agent_tell`.",
      "properties": {
        "agent": {
          "description": "The agent's id.",
          "type": "string"
        },
        "idempotency_key": {
          "description": "A name for this call's effect, such as a fresh UUID; a repeat answers as the first did.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The words.",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "text"
      ],
      "title": "AgentTellArgs",
      "type": "object"
    },
    "name": "agent_tell"
  },
  {
    "input_schema": {
      "$defs": {
        "ViewArg": {
          "description": "How much of a thread a read gives.",
          "oneOf": [
            {
              "const": "messages",
              "description": "What was said.",
              "type": "string"
            },
            {
              "const": "activity",
              "description": "What was said and done.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`agent_read`.",
      "properties": {
        "after": {
          "description": "The last turn already read: the `next` of the previous read. From the first turn held\nwhen omitted.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "agent": {
          "description": "The agent's id, or a subagent's thread id.",
          "type": "string"
        },
        "view": {
          "$ref": "#/$defs/ViewArg",
          "description": "`messages` (the default) for what was said, `activity` for that and every tool call\nwith the end of its output."
        }
      },
      "required": [
        "agent"
      ],
      "title": "AgentReadArgs",
      "type": "object"
    },
    "name": "agent_read"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`agent_wait`.",
      "properties": {
        "agents": {
          "description": "The agents' ids, at most 64.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "all": {
          "default": false,
          "description": "Wait for every one; the first one when false (the default).",
          "type": "boolean"
        },
        "timeout_ms": {
          "description": "How long to wait, in milliseconds, at most 240000; 60000 when omitted.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "agents"
      ],
      "title": "AgentWaitArgs",
      "type": "object"
    },
    "name": "agent_wait"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`agent_stop`.",
      "properties": {
        "agent": {
          "description": "The agent's id.",
          "type": "string"
        },
        "idempotency_key": {
          "description": "A name for this call's effect, such as a fresh UUID; a repeat answers as the first did.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent"
      ],
      "title": "AgentStopArgs",
      "type": "object"
    },
    "name": "agent_stop"
  },
  {
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "agents"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`branch_bring`.",
      "properties": {
        "branch": {
          "description": "The branch.",
          "type": "string"
        },
        "from": {
          "description": "The machine the branch is on, by name or id.",
          "type": "string"
        },
        "idempotency_key": {
          "description": "A name for this call's effect, such as a fresh UUID; a repeat answers as the first did.",
          "type": [
            "string",
            "null"
          ]
        },
        "into": {
          "description": "The clone it lands in there; that machine's clone of the same repository when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The name it lands as; its own when omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "The clone or worktree it is in there.",
          "type": "string"
        },
        "to": {
          "description": "The machine it goes to, by name or id.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "repo",
        "branch",
        "to"
      ],
      "title": "BranchBringArgs",
      "type": "object"
    },
    "name": "branch_bring"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`show_visual`.",
      "properties": {
        "assets": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Files the script uses, by the name it uses them: `{ \"prism.glb\": \"models/prism.glb\" }`.\nPaths are on this machine, relative to your working directory. glTF models (.glb, or\n.gltf with everything embedded), PNG, JPEG, WebP and Radiance .hdr images; at most 16\nfiles, 8 MB each, 10 MB together.",
          "type": "object"
        },
        "script": {
          "description": "The Luau visual script: setup at the top level, ending with `return function() return\nui.column { ... } end`.",
          "type": "string"
        },
        "title": {
          "description": "A short name for the visual.",
          "type": "string"
        }
      },
      "required": [
        "script",
        "title"
      ],
      "title": "ShowVisualArgs",
      "type": "object"
    },
    "name": "show_visual"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`show_page`.",
      "properties": {
        "file": {
          "description": "An `.html`, `.htm` or `.svg` file on this machine, relative to your working directory:\nshown as it is, its relative files (`./data.csv`) beside it, and shown again when it\nchanges. A `.pdf`, `.csv` or `.tsv` file shows natively: a PDF's pages, a table. Give\nthis or `html`.",
          "type": [
            "string",
            "null"
          ]
        },
        "html": {
          "description": "The page: an HTML document or fragment, or an SVG that starts with `<svg`. Give this or\n`file`.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "A short name for the page.",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "ShowPageArgs",
      "type": "object"
    },
    "name": "show_page"
  },
  {
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "ui_state"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`ui_terminal`.",
      "properties": {
        "command": {
          "description": "A command line to type once its shell is up.",
          "type": [
            "string",
            "null"
          ]
        },
        "folder": {
          "description": "The folder it starts in, relative to your working folder; your working folder when\nomitted.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "TerminalArgs",
      "type": "object"
    },
    "name": "ui_terminal"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`ui_open`, and what `ui_split` shows first.",
      "properties": {
        "diff": {
          "default": false,
          "description": "The chat's uncommitted changes.",
          "type": "boolean"
        },
        "file": {
          "description": "A file on this machine, relative to your working folder; `path:line` names a line.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "The line of `file` to start at, from 1.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "description": "A web page's `http` or `https` address.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "OpenArgs",
      "type": "object"
    },
    "name": "ui_open"
  },
  {
    "input_schema": {
      "$defs": {
        "ChangeArg": {
          "description": "What becomes of a region.",
          "oneOf": [
            {
              "const": "show",
              "description": "On screen.",
              "type": "string"
            },
            {
              "const": "hide",
              "description": "Off screen.",
              "type": "string"
            },
            {
              "const": "toggle",
              "description": "The other of the two.",
              "type": "string"
            },
            {
              "const": "expand",
              "description": "As large as it goes: shown.",
              "type": "string"
            },
            {
              "const": "collapse",
              "description": "Back out of the way: hidden.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`ui_region`.",
      "properties": {
        "change": {
          "$ref": "#/$defs/ChangeArg",
          "description": "What becomes of it."
        },
        "region": {
          "description": "`sidebar`, `files`, `changes`, `inspector` or `terminal`.",
          "type": "string"
        }
      },
      "required": [
        "region",
        "change"
      ],
      "title": "RegionArgs",
      "type": "object"
    },
    "name": "ui_region"
  },
  {
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`ui_chat`.",
      "properties": {
